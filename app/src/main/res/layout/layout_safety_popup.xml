<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:layout_gravity="end|center_vertical"
    android:layout_marginEnd="16dp"
    android:visibility="gone"
    app:cardCornerRadius="12dp"
    app:cardElevation="8dp">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 타이틀 및 닫기 버튼 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            
            <TextView
                android:id="@+id/tv_popup_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="지역 안전 정보"
                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <ImageButton
                android:id="@+id/btn_popup_close"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="닫기"
                android:src="@android:drawable/ic_menu_close_clear_cancel"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="#DDDDDD"/>

        <!-- 상세 정보 항목들 -->
        <TextView
            android:id="@+id/tv_popup_gu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="행정구: -"
            android:textColor="#555555"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tv_popup_centers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="안전센터/구조대 : 0개"
            android:textColor="#555555"
            android:textSize="14sp"/>
        
        <TextView
            android:id="@+id/tv_popup_fire_stations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="소방서 : 0개"
            android:textColor="#555555"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tv_popup_score"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="안전점수 : -등급"
            android:textColor="#00796B"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_popup_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="이유 : -"
            android:textColor="#666666"
            android:textSize="12sp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>