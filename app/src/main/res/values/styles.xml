<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 병원 하위 카테고리 버튼 속성-->
    <style name="HospitalCategoryButton"
        parent="Widget.MaterialComponents.Button">

        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_margin">1.8dp</item>
        <item name="android:layout_columnWeight">1</item>

        <item name="android:textColor">#6B3532</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>

        <item name="backgroundTint">#F7C6C2</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">#EBA8A2</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- 소방서, 안전센터, 병원 메인 버튼 -->
    <style name="MainCategoryButton"
        parent="Widget.MaterialComponents.Button">

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginBottom">8dp</item>

        <item name="android:textColor">#6B3532</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>

        <item name="backgroundTint">#F2B7B2</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">#EBA8A2</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>